# ---- Sessão / PIN -------------------------------------------------
# Gere com: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=troque-isto
# PIN de acesso ao app (apenas dígitos, 4-8). Uso pessoal single-user.
APP_PIN=1234

# ---- Supabase (projeto pessoal, isolado) ---------------------------
# Se ficarem vazios, o app cai automaticamente para SQLite local (dev).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role: fica SÓ no servidor, nunca no front-end.
SUPABASE_SERVICE_KEY=

# ---- Anthropic (leitura de recibos por foto) ------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Local ----------------------------------------------------------
SQLITE_PATH=financas.sqlite3
PORT=5000
